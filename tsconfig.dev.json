//开发环境的合约文件路径(localnet)
//和tsconfig.json同节点的定义不能合并，只能覆盖，所以需要把tsconfig.json中的path定义复制过来

{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@project/anchor": [
                "anchor/src"
            ],
            "@/*": [
                "./src/*"
            ],
            "@program/*": ["anchor/target/*"]
        }
    }
}